<!DOCTYPE CrossStudio_Project_File>
<solution Name="serialtestcode" target="8" version="2">
  <configuration
    Name="Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None"
    hidden="Yes" />
  <configuration
    Name="Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="None"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 1"
    hidden="Yes" />
  <configuration
    Name="THUMB"
    Platform="ARM"
    arm_instruction_set="Thumb"
    arm_library_instruction_set="Thumb"
    c_preprocessor_definitions="__THUMB"
    hidden="Yes" />
  <configuration Name="THUMB Debug" inherited_configurations="THUMB;Debug" />
  <configuration
    Name="THUMB Release"
    inherited_configurations="THUMB;Release" />
  <project Name="serialtestcode">
    <configuration
      CMSIS_CORE="Yes"
      Name="Common"
      Placement="Flash"
      Target="STM32F411CE"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_fp_abi="Soft"
      arm_fpu_type="FPv4-SP-D16"
      arm_linker_heap_size="4096"
      arm_linker_jtag_pad_pre_dr="1"
      arm_linker_jtag_pad_pre_ir="5"
      arm_linker_process_stack_size="0"
      arm_linker_stack_size="8192"
      arm_simulator_memory_simulation_filename="$(TargetsDir)/STM32/STM32SimulatorMemory$(HostDLL)"
      arm_simulator_memory_simulation_parameter="STM32F411CE;0x80000;0x20000"
      arm_target_loader_applicable_loaders="Flash"
      arm_target_loader_default_loader="Flash"
      arm_target_trace_interface_type="None"
      c_preprocessor_definitions="USE_FULL_LL_DRIVER"
      c_user_include_directories="$(TargetsDir)/STM32/include;$(ProjectDir)/inc"
      debug_register_definition_file="$(TargetsDir)/STM32/STM32F411_Peripherals.xml"
      linker_memory_map_file="$(TargetsDir)/STM32/STM32F411CE_MemoryMap.xml"
      linker_section_placement_file="$(StudioDir)/targets/Cortex_M/flash_placement.xml"
      macros="DeviceVectorsFile=STM32F411xE.vec"
      project_directory=""
      project_type="Executable"
      property_groups_file_path="$(TargetsDir)/STM32/propertyGroups.xml"
      target_get_partname_script="GetPartName()"
      target_match_partname_script="MatchPartName(&quot;$(Target)&quot;)"
      target_script_file="$(TargetsDir)/STM32/STM32_Target.js"
      target_trace_initialize_script="EnableTrace(&quot;$(TraceInterfaceType)&quot;)" />
    <configuration
      Name="Flash"
      arm_target_flash_loader_file_path="$(LOADER:$(TargetsDir)/STM32/Release/STM32F2xx_Loader_rpc.elf)"
      arm_target_loader_can_erase_all="Yes"
      arm_target_loader_can_lock_all="No"
      arm_target_loader_can_lock_range="No"
      arm_target_loader_can_unlock_all="No"
      arm_target_loader_can_unlock_range="No"
      target_reset_script="FLASHReset()" />
    <configuration Name="RAM" target_reset_script="Reset()" />
    <folder Name="Source Files">
      <configuration Name="Common" filter="c;cpp;cxx;cc;h;s;asm;inc" />
      <folder Name="inc">
        <file file_name="inc/stm32f4xx_ll_bus.h" />
        <file file_name="inc/stm32f4xx_ll_dma.h" />
        <file file_name="inc/stm32f4xx_ll_gpio.h" />
        <file file_name="inc/stm32f4xx_ll_pwr.h" />
        <file file_name="inc/stm32f4xx_ll_rcc.h" />
        <file file_name="inc/stm32f4xx_ll_system.h" />
        <file file_name="inc/stm32f4xx_ll_tim.h" />
        <file file_name="inc/stm32f4xx_ll_usart.h" />
        <file file_name="inc/stm32f4xx_ll_utils.h" />
        <file file_name="inc/system_stm32f4xx.h" />
      </folder>
      <folder Name="src">
        <file file_name="src/stm32f4xx_ll_dma.c" />
        <file file_name="src/stm32f4xx_ll_gpio.c" />
        <file file_name="src/stm32f4xx_ll_rcc.c" />
        <file file_name="src/stm32f4xx_ll_tim.c" />
        <file file_name="src/stm32f4xx_ll_usart.c" />
        <file file_name="src/stm32f4xx_ll_utils.c" />
        <file file_name="src/system_stm32f4xx.c" />
      </folder>
      <file file_name="boardfile.c" />
      <file file_name="boardfile.h" />
      <file file_name="clock_init.c" />
      <file file_name="clock_init.h" />
      <file file_name="dma.c" />
      <file file_name="dma.h" />
      <file file_name="main.c" />
      <file file_name="main.h" />
      <file file_name="serial.c" />
      <file file_name="serial.h" />
      <file file_name="timer.c" />
      <file file_name="timer.h" />
    </folder>
    <folder Name="System Files">
      <file file_name="$(TargetsDir)/STM32/$(DeviceVectorsFile)" />
      <file file_name="$(TargetsDir)/STM32/STM32_Startup.s" />
      <file file_name="$(StudioDir)/source/thumb_crt0.s" />
    </folder>
  </project>
</solution>
